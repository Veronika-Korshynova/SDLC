@startuml
|Пользователь|
start
fork
  :Настроить профиль;
  (A)
  group Форма редактирования профиля {
    :Указать целевые КБЖУ;
    :Указать список аллергенов;
    :Указать предпочитаемые и исключенные продукты;
    if (Сохранить настройки?) then (да)
      :Сохранить данные профиля;
    else (нет)
      :Отменить внесенные изменения;
    endif
  }
  end

fork again
  (B)
  switch (Отобразить меню из блюд и информацию о КБЖУ)
  case (Заменить блюдо)
    group Форма замены блюда {
      :Отобразить список доступных блюд для замены;
      :Пересчитать КБЖУ;
      if (Сохранить изменения меню?) then(да)
        :Сохранить меню;
      else (нет)
        :Отменить изменения;
      endif
    }
    (A)
    detach
  case (Показать список покупок)
    :Отобразить список покупок по дням;
    end
  case (Показать отдельное блюдо)
    :Отобразить подробную информацию о КБЖУ блюда;
    :Отобразить рецепт и список продуктов;
    end
  endswitch
  
  
fork again
  :Сформировать недельное меню;
  if (Данные профиля заполнены?) then (нет)
    |Пользователь|
    :Перенаправить пользователя на заполнение профиля;
    (A)
    detach
  else (да)
    :Запросить подбор меню;
    |Система ПП-План|
    :Подобрать набор продуктов исключая указанные и аллергены;
    :Подобрать блюда согласно целевому и выбранным продуктам КБЖУ;
    :Создать недельное меню;
    |Пользователь|
    :Отобразить сформированное меню;
    (B)
    detach
  endif
end merge

@enduml